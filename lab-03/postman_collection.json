    "name": "Lab 03 - Books REST API",
    "description": "Postman test collection covering all success and failure cases for Lab 3: REST API, query parameters, validation, and debugging.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. GET all books (Default params)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/books",
          "host": ["{{baseUrl}}"],
          "path": ["books"]
        }
      },
      "response": []
    },
    {
      "name": "2. GET books with search_q filter",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/books?search_q=Clean",
          "host": ["{{baseUrl}}"],
          "path": ["books"],
          "query": [
            {
              "key": "search_q",
              "value": "Clean"
            }
          ]
        }
      },
      "response": []
    },
    {
      "name": "3. GET books sorted by price DESC",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/books?order_by=price&order=DESC",
          "host": ["{{baseUrl}}"],
          "path": ["books"],
          "query": [
            {
              "key": "order_by",
              "value": "price"
            },
            {
              "key": "order",
              "value": "DESC"
            }
          ]
        }
      },
      "response": []
    },
    {
      "name": "4. GET books pagination (limit=3, offset=0)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/books?limit=3&offset=0",
          "host": ["{{baseUrl}}"],
          "path": ["books"],
          "query": [
            {
              "key": "limit",
              "value": "3"
            },
            {
              "key": "offset",
              "value": "0"
            }
          ]
        }
      },
      "response": []
    },
    {
      "name": "5. GET books price range BETWEEN 300 AND 600",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/books?min_price=300&max_price=600",
          "host": ["{{baseUrl}}"],
          "path": ["books"],
          "query": [
            {
              "key": "min_price",
              "value": "300"
            },
            {
              "key": "max_price",
              "value": "600"
            }
          ]
        }
      },
      "response": []
    },
    {
      "name": "6. GET books combined search, sort, and price filter",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/books?search_q=Programmer&min_price=500&max_price=600&order_by=price&order=ASC",
          "host": ["{{baseUrl}}"],
          "path": ["books"],
          "query": [
            {
              "key": "search_q",
              "value": "Programmer"
            },
            {
              "key": "min_price",
              "value": "500"
            },
            {
              "key": "max_price",
              "value": "600"
            },
            {
              "key": "order_by",
              "value": "price"
            },
            {
              "key": "order",
              "value": "ASC"
            }
          ]
        }
      },
      "response": []
    },
